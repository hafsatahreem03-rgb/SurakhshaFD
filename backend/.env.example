# Copy this file to backend/.env and adjust. Never commit a real .env file.

# REQUIRED for anything beyond local development: a long random string.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string

# Login session length in minutes
ACCESS_TOKEN_MINUTES=480

# SQLite for the prototype. For PostgreSQL later: postgresql+psycopg://user:pass@host:5432/surakshafd
# DATABASE_URL=sqlite:///./data/surakshafd.db

# Where uploaded documents are stored (default: backend/data/uploads)
# STORAGE_DIR=./data/uploads
MAX_UPLOAD_MB=10

# Leave empty to auto-detect Tesseract (PATH, then C:\Program Files\Tesseract-OCR\tesseract.exe)
TESSERACT_CMD=

# Frontend origins allowed to call the API directly (the Vite dev proxy doesn't need this)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# How often the deadline alert job runs automatically (minutes). 0 disables it.
ALERT_INTERVAL_MINUTES=60

# Judge Demonstration Mode: Live Evidence panel (API calls, database rows, audit), request log file and
# in-app demo reset. Set to false for anything other than a local demonstration.
DEMO_MODE=true

# Bank verification adapter. Only "simulated" exists in this prototype - no real bank is contacted.
BANK_ADAPTER=simulated
